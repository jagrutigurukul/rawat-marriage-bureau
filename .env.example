# ================= Rawat Marriage Bureau — settings =================
# Locally: copy to ".env" and fill in.   On Vercel: add the same names in Project → Settings → Environment Variables.
# Check everything before deploying:  npm run check

# ---- Supabase project ----
SUPABASE_PROJECT_REF=xiscjfavgynnwqjxovdt
# Supabase → Connect → "Transaction pooler" → URI. Replace [YOUR-PASSWORD] and copy the host exactly as shown there.
DATABASE_URL=postgresql://postgres.xiscjfavgynnwqjxovdt:[YOUR-PASSWORD]@<pooler-host>.pooler.supabase.com:6543/postgres

# ---- Login security ----
# 64 random characters. Never change after going live (everyone would be logged out).
JWT_SECRET=paste-a-long-random-string-here
TOKEN_DAYS=7

# ---- First super admin (created on the first visit if none exists) ----
SUPERADMIN_NAME=Kamlesh Rawat
SUPERADMIN_PHONE=
SUPERADMIN_EMAIL=kamleshsoftdev@gmail.com
SUPERADMIN_PASSWORD=

# ---- Shown on "Call the bureau" buttons (optional) ----
BUREAU_PHONE=

# Note: the Supabase anon / service_role API keys are NOT needed — the server connects with DATABASE_URL,
# and Row Level Security blocks the public anon key from all tables.
